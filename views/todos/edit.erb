<form action="/todos/<%= @todo["id"] %>/update" method="post">
    <h2>Ändra todo</h2>
    <label for="name"><h3>Namn</h3></label>
    <input type="text" name="name" value="<%= @todo["name"]%> "required>

    <label for="description"><h3>Beskrivning</h3></label>
    <input type="text" name="description" value="<%= @todo["description"] %>"required>

    <label for="category"><h3>Kategori</h3></label>
    <select name="category" required>
        <% @categories.each do |cat| %>
        <option value="<%= cat["id"] %>"><%= cat["name"] %></option>
        <% end%>
    </select>

    <br>
    <input type="submit" value="Ändra">
</form>